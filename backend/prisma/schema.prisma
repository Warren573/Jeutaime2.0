// ============================================================
// JeuTaime — Schéma Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Gender {
  HOMME
  FEMME
  AUTRE
}

enum LookingFor {
  AMITIE
  RELATION
  FLIRT
  DISCUSSION
  SERIEUX
}

enum MatchStatus {
  PENDING   // en attente d'acceptation
  ACTIVE    // match actif, échanges en cours
  BROKEN    // lien rompu par un des deux
  BLOCKED   // blocage
  GHOSTED   // inactivité détectée (5 jours)
}

enum LetterStatus {
  SENT
  READ
}

enum CoinTxnType {
  DAILY_BONUS
  GAME_WIN
  GAME_ENTRY
  LETTER_SENT
  OFFERING_SENT
  POWER_USED
  PET_ADOPTION
  PET_CARE
  PREMIUM_PURCHASE
  STORY_PARTICIPATION
  STORY_COMPLETION
  REFUND
  ADMIN_ADJUST
  PURCHASE_COINS
  REFUGE_PARTIAL_REWARD
  REFUGE_PERFECT_REWARD
  REFUGE_PARTICIPATION_REWARD
  REFUGE_INACTIVITY_PENALTY
}

enum CardGameStatus {
  ACTIVE
  CLAIMED
  EXPIRED
}

enum OfferingCategory {
  BOISSON
  NOURRITURE
  SYMBOLIQUE
  HUMOUR
}

enum MagieType {
  TRANSFORMATION
  VISUAL_EFFECT
  WEATHER
}

enum ConsumptionMode {
  PRIVATE
  SHARED
}

enum SalonKind {
  PISCINE
  CAFE_DE_PARIS
  ILE_PIRATES
  THEATRE
  BAR_COCKTAILS
  METAL
  PSY
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum ReportReason {
  HARASSMENT
  SPAM
  FAKE
  INAPPROPRIATE_CONTENT
  MINOR
  OTHER
}

enum PremiumTier {
  FREE
  PREMIUM
}

enum NotificationType {
  LETTER_RECEIVED
  MATCH_CREATED
  OFFERING_RECEIVED
  MAGIE_RECEIVED
  MAGIE_BROKEN
  PREMIUM_SUBSCRIBED
  PREMIUM_CANCELLED
}

enum ReactionType {
  SMILE
  GRIMACE
}

// ============================================================
// BOUTEILLE À LA MER (Chantier 1 - V1)
// ============================================================

enum BottleStatus {
  FLOATING    // En attente de réception
  ACCEPTED    // Acceptée par un utilisateur, discussion anonyme en cours
  REVEALED    // Dévoilement accepté par les deux, devient discussion privée classique
  BROKEN      // Rompue définitivement par l'un des deux participants
  EXPIRED     // 30 jours écoulés
}

enum BottleReceiptStatus {
  PENDING     // En attente de réponse
  ACCEPTED    // Acceptée
  REFUSED     // Refusée
  TAKEN       // Prise par quelqu'un d'autre
}

enum BottleRevealStatus {
  PENDING     // En attente de réponse de l'autre participant
  ACCEPTED    // Dévoilement accepté par les deux
  REFUSED     // Refusé par le répondant
}

// ============================================================
// USER / AUTH
// ============================================================

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(USER)
  isVerified   Boolean     @default(false)
  isBanned     Boolean     @default(false)
  banReason    String?
  premiumTier  PremiumTier @default(FREE)
  premiumUntil DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile         Profile?
  wallet          Wallet?
  settings        UserSettings?
  refreshTokens   RefreshToken[]

  sentLetters     Letter[]        @relation("LetterFrom")
  receivedLetters Letter[]        @relation("LetterTo")
  matchesAsA      Match[]         @relation("MatchUserA")
  matchesAsB      Match[]         @relation("MatchUserB")
  photos          Photo[]
  pets            Pet[]
  salonMessages   SalonMessage[]
  offeringsSent   OfferingSent[]  @relation("OfferingFrom")
  offeringsRecv   OfferingSent[]  @relation("OfferingTo")
  magiesCast      MagieCast[]     @relation("MagieFrom")
  magiesRecv      MagieCast[]     @relation("MagieTo")
  reportsMade     Report[]        @relation("ReportReporter")
  reportsAgainst  Report[]        @relation("ReportTarget")
  blocksMade      Block[]         @relation("BlockFrom")
  blocksAgainst   Block[]         @relation("BlockTo")
  auditLogs       AuditLog[]
  notifications   Notification[]
  reactionsGiven    Reaction[]    @relation("ReactionFrom")
  reactionsReceived Reaction[]    @relation("ReactionTo")
  questionAttempts  MatchQuestionAttempt[] @relation("QuestionAttemptResponder")
  cardGameSessions  CardGameSession[]
  pushTokens        PushToken[]
  salonSessionParticipants SalonSessionParticipant[]
  encounters1       SalonEncounter[]  @relation("Encounter1")
  encounters2       SalonEncounter[]  @relation("Encounter2")

  bottlesSent       MessageInABottle[] @relation("BottleSender")
  bottlesAccepted   MessageInABottle[] @relation("BottleAcceptedBy")
  bottleReceipts    BottleReceipt[]
  anonymousMessages AnonymousMessage[]
  bottleSuspension  BottleSuspension?

  refugeAsAdopte    RefugeSession[]   @relation("RefugeAdopte")
  refugeAsAdoptant  RefugeSession[]   @relation("RefugeAdoptant")

  @@index([email])
  @@index([isBanned])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// PROFIL
// ============================================================

model Profile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  pseudo       String      @unique
  birthDate    DateTime
  gender       Gender
  interestedIn Gender[]
  city         String
  postalCode   String?
  bio          String?     @db.Text
  physicalDesc String?
  job          String?
  interests    String[]
  lookingFor   LookingFor[]
  hasChildren  Boolean?
  wantsChildren Boolean?
  avatarConfig Json?

  // V1 — champs enrichis
  height       Int?
  vibe         String?
  quote        String?
  identityTags String[]
  qualities    String[]
  defaults     String[]
  idealDay     String[]
  skills       Json?

  // Progression
  points       Int         @default(0)
  badges       String[]    @default([])

  questions    ProfileQuestion[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([city])
  @@index([gender])
  @@index([points])
}

model ProfileQuestion {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questionId   String
  questionText String?  @db.Text
  answer       String   @db.Text
  wrongAnswers String[] @default([])

  @@unique([profileId, questionId])
}

model UserSettings {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifEmail         Boolean @default(true)
  notifPush          Boolean @default(true)
  soundEnabled       Boolean @default(true)
  language           String  @default("fr")
  showInDiscovery    Boolean @default(true)
  locationShared     Boolean @default(false)
  showPhotoByDefault Boolean @default(true)
}

// ============================================================
// PHOTOS (floutées par défaut)
// Déverrouillage calculé côté service (non stocké)
// Free    : letterCountA >= 10 && letterCountB >= 10
// Premium : letterCountA >= 3  && letterCountB >= 3
// ============================================================

model Photo {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPath    String
  blurredPath     String
  blurMediumPath  String?
  position      Int      @default(0)
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ============================================================
// MATCH + LETTRES
// Match unique non orienté : on garantit userAId < userBId
// ============================================================

model Match {
  id                    String      @id @default(cuid())
  // Contrainte non orientée : userAId < userBId (cuid lexicographique)
  userAId               String
  userBId               String
  userA                 User        @relation("MatchUserA", fields: [userAId], references: [id])
  userB                 User        @relation("MatchUserB", fields: [userBId], references: [id])

  status                MatchStatus @default(PENDING)

  // Qui a initié la demande (pour déterminer qui envoie la 1ère lettre)
  initiatorId           String

  // Compteurs de lettres par côté (pour calcul unlock)
  letterCountA          Int         @default(0)
  letterCountB          Int         @default(0)

  // Alternation : userId du dernier expéditeur
  lastLetterBy          String?
  lastLetterAt          DateTime?

  // Questions de validation (les 2 doivent avoir répondu)
  questionsValidated    Boolean     @default(false)

  // Anti-ghosting : ID de celui qui a utilisé sa relance unique
  ghostRelanceUsedBy    String?
  ghostDetectedAt       DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  letters               Letter[]
  questionAttempts      MatchQuestionAttempt[]

  @@unique([userAId, userBId])
  @@index([status])
  @@index([userAId])
  @@index([userBId])
}

model Letter {
  id              String       @id @default(cuid())
  matchId         String
  match           Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromUserId      String
  toUserId        String
  fromUser        User         @relation("LetterFrom", fields: [fromUserId], references: [id])
  toUser          User         @relation("LetterTo",   fields: [toUserId],   references: [id])

  content         String       @db.Text  // max 3000 chars validé côté Zod + service
  status          LetterStatus @default(SENT)
  isGhostRelance  Boolean      @default(false)  // lettre de relance anti-ghosting
  sentAt          DateTime     @default(now())
  readAt          DateTime?

  @@index([matchId, sentAt])
  @@index([toUserId, status])
}

// ============================================================
// ÉCONOMIE
// ============================================================

model Wallet {
  userId         String          @id
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coins          Int             @default(0)
  lastDailyBonus DateTime?
  updatedAt      DateTime        @updatedAt
  transactions   CoinTransaction[]
}

model CoinTransaction {
  id        String      @id @default(cuid())
  walletId  String
  wallet    Wallet      @relation(fields: [walletId], references: [userId], onDelete: Cascade)
  type      CoinTxnType
  amount    Int         // signé : + crédit, - débit
  balance   Int         // solde après transaction
  meta      Json?       // contexte libre (offeringId, petId, reason...)
  createdAt DateTime    @default(now())

  @@index([walletId, createdAt])
}

// ============================================================
// OFFRANDES
// ============================================================

model OfferingCatalog {
  id              String           @id
  emoji           String
  name            String
  cost            Int
  category        OfferingCategory
  durationMs      Int?
  stackPriority   Int              @default(0)
  salonOnly       SalonKind?
  enabled         Boolean          @default(true)
  consumptionMode ConsumptionMode  @default(SHARED)

  sentOfferings OfferingSent[]
}

model OfferingSent {
  id              String          @id @default(cuid())
  offeringId      String
  offering        OfferingCatalog @relation(fields: [offeringId], references: [id])
  fromUserId      String
  toUserId        String
  fromUser        User            @relation("OfferingFrom", fields: [fromUserId], references: [id])
  toUser          User            @relation("OfferingTo",   fields: [toUserId],   references: [id])
  salonId         String?
  salon           Salon?          @relation(fields: [salonId], references: [id])
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  consumptionCount Int            @default(0)
  lastConsumedAt  DateTime?
  lastConsumedBy  String?

  @@index([toUserId])
  @@index([salonId])
}

// ============================================================
// MAGIES / POUVOIRS
// ============================================================

model MagieCatalog {
  id               String    @id
  emoji            String
  name             String
  cost             Int
  durationSec      Int
  type             MagieType
  breakConditionId String?   // ex: "kiss", "compliment", "water"...
  enabled          Boolean   @default(true)

  casts            MagieCast[]
}

model MagieCast {
  id         String       @id @default(cuid())
  magieId    String
  magie      MagieCatalog @relation(fields: [magieId], references: [id])
  fromUserId String
  toUserId   String
  fromUser   User         @relation("MagieFrom", fields: [fromUserId], references: [id])
  toUser     User         @relation("MagieTo",   fields: [toUserId],   references: [id])
  salonId    String?
  salon      Salon?       @relation(fields: [salonId], references: [id])
  castAt     DateTime     @default(now())
  expiresAt  DateTime
  brokenAt   DateTime?
  brokenBy   String?

  @@index([toUserId, expiresAt])
}

// ============================================================
// SALON SESSIONS (Chantier 1)
// ============================================================

enum SalonSessionStatus {
  ACTIVE
  EXPIRED
}

enum SalonSessionParticipantStatus {
  ACTIVE
  LEFT
}

model SalonSession {
  id            String                      @id @default(cuid())
  salonKind     SalonKind
  salon         Salon                       @relation(fields: [salonKind], references: [kind])
  startedAt     DateTime                    @default(now())
  expiresAt     DateTime                    // 7 days from startedAt
  status        SalonSessionStatus          @default(ACTIVE)
  isPrivate     Boolean                     @default(false) // V1.1+: for private salons
  ownerId       String?                     // V1.1+: creator for private sessions

  participants  SalonSessionParticipant[]
  encounters    SalonEncounter[]
  messages      SalonMessage[]

  @@index([salonKind, status, expiresAt])
}

model SalonSessionParticipant {
  id        String                          @id @default(cuid())
  sessionId String
  session   SalonSession                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SalonSessionParticipantStatus   @default(ACTIVE)
  joinedAt  DateTime                        @default(now())
  leftAt    DateTime?

  @@unique([sessionId, userId])
  @@index([userId, status])
}

model SalonEncounter {
  id        String           @id @default(cuid())
  sessionId String
  session   SalonSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user1Id   String
  user1     User             @relation("Encounter1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User             @relation("Encounter2", fields: [user2Id], references: [id], onDelete: Cascade)
  metAt     DateTime         @default(now())

  @@unique([sessionId, user1Id, user2Id])
  @@index([sessionId])
}

// ============================================================
// SALONS
// ============================================================

model Salon {
  id          String       @id @default(cuid())
  kind        SalonKind    @unique
  name        String
  description String?      @db.Text
  magicAction String?
  gradient    Json?

  // --- CMS visuel (Phase 5) ------------------------------
  backgroundImage  String?  // URL API /api/files/salons/... ou chemin relatif public
  backgroundType   String   @default("gradient") // "image" | "gradient" | "color"
  backgroundConfig Json?    // { start, end, angle } ou { color } ou { url, position }
  primaryColor     String?  // ex: "#FF6B9D"
  secondaryColor   String?
  textColor        String?

  // --- Gestion admin --------------------------------------
  isActive   Boolean  @default(true)
  order      Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   SalonMessage[]
  offerings  OfferingSent[]
  magies     MagieCast[]
  sessions   SalonSession[]

  @@index([isActive, order])
}

model SalonMessage {
  id        String         @id @default(cuid())
  salonId   String
  salon     Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  sessionId String?
  session   SalonSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String         // "message" | "offering" | "power" | "system"
  content   String         @db.Text
  meta      Json?
  createdAt DateTime       @default(now())

  @@index([salonId, createdAt])
  @@index([sessionId, createdAt])
}

// ============================================================
// BOUTEILLE À LA MER (V1)
// ============================================================

model MessageInABottle {
  id            String                @id @default(cuid())
  senderId      String
  sender        User                  @relation("BottleSender", fields: [senderId], references: [id], onDelete: Cascade)
  message       String                @db.Text
  senderCity    String                // Ville du sender au moment du create
  targetGender  String                // "HOMME" | "FEMME" | "AUTRE"
  ageMin        Int
  ageMax        Int
  status        BottleStatus          @default(FLOATING)
  acceptedById  String?
  acceptedBy    User?                 @relation("BottleAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  createdAt     DateTime              @default(now())
  expiresAt     DateTime              // 30 jours
  lastReadBySenderId    DateTime?      // Quand l'envoyeur a lu les messages
  lastReadByAcceptorId  DateTime?      // Quand l'accepteur a lu les messages
  revealedAt    DateTime?             // Quand les deux ont accepté le dévoilement
  matchId       String?               // Match créé après dévoilement (liens vers discussion privée)
  match         Match?                @relation(fields: [matchId], references: [id], onDelete: SetNull)

  receipts      BottleReceipt[]
  messages      AnonymousMessage[]
  revealRequests BottleRevealRequest[]

  @@index([status, expiresAt])
  @@index([senderId, status])
}

model BottleReceipt {
  id          String              @id @default(cuid())
  bottleId    String
  bottle      MessageInABottle    @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status      BottleReceiptStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  actionAt    DateTime?

  @@unique([bottleId, recipientId])
  @@index([recipientId, status])
}

model AnonymousMessage {
  id        String            @id @default(cuid())
  bottleId  String
  bottle    MessageInABottle  @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String            @db.Text
  createdAt DateTime          @default(now())

  @@index([bottleId, createdAt])
}

model BottleRevealRequest {
  id            String              @id @default(cuid())
  bottleId      String
  bottle        MessageInABottle    @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  requestedById String              // Qui a demandé le dévoilement
  requestedBy   User                @relation("RevealRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  respondentId  String              // Qui doit répondre (l'autre participant)
  respondent    User                @relation("RevealRespondent", fields: [respondentId], references: [id], onDelete: Cascade)
  status        BottleRevealStatus  @default(PENDING)
  createdAt     DateTime            @default(now())
  respondedAt   DateTime?

  @@unique([bottleId, requestedById])
  @@index([bottleId, status])
  @@index([respondentId, status])
}

model BottleSuspension {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   @db.Text
  reportCount Int    @default(1)
  startedAt DateTime @default(now())
  endsAt    DateTime // 7 jours

  @@index([userId, endsAt])
}

// ============================================================
// ANIMAUX VIRTUELS
// ============================================================

model PetCatalog {
  id      String  @id
  name    String
  emoji   String
  cost    Int
  enabled Boolean @default(true)

  pets    Pet[]
}

model Pet {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId    String
  catalog      PetCatalog @relation(fields: [catalogId], references: [id])
  name         String
  hunger       Int        @default(100)
  happiness    Int        @default(100)
  energy       Int        @default(100)
  cleanliness  Int        @default(100)
  xp           Int        @default(0)
  level        Int        @default(1)
  isIncarnated Boolean    @default(false)
  lastUpdated  DateTime   @default(now())
  adoptedAt    DateTime   @default(now())

  @@index([userId])
}

// ============================================================
// MODÉRATION
// ============================================================

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("ReportReporter", fields: [reporterId], references: [id])
  targetId   String
  target     User         @relation("ReportTarget",   fields: [targetId],   references: [id])
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(OPEN)
  resolution String?      @db.Text
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([status])
  @@index([targetId])
}

model Block {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  from      User     @relation("BlockFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("BlockTo",   fields: [toId],   references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

// ============================================================
// RÉACTIONS — Sourire / Grimace (système de découverte)
// Un utilisateur peut réagir une seule fois à un profil.
// Sourire mutuel → match créé automatiquement.
// ============================================================

model Reaction {
  id        String       @id @default(cuid())
  fromId    String
  toId      String
  from      User         @relation("ReactionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User         @relation("ReactionTo",   fields: [toId],   references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

// ============================================================
// JEU DES 3 QUESTIONS — Réponses soumises pendant le jeu de validation
// Un joueur répond aux 3 questions de l'autre (ProfileQuestion de l'autre).
// Sourire mutuel → match créé → les deux jouent → si ≥1 correct chacun → validé
// ============================================================

model MatchQuestionAttempt {
  id              String   @id @default(cuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  responderId     String
  responder       User     @relation("QuestionAttemptResponder", fields: [responderId], references: [id], onDelete: Cascade)
  questionId      String   // ProfileQuestion.id de l'autre utilisateur
  submittedAnswer String
  isCorrect       Boolean
  createdAt       DateTime @default(now())

  @@unique([matchId, responderId, questionId])
  @@index([matchId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
}

// ============================================================
// NOTIFICATIONS (Phase 10)
// Alimentées par les event handlers, stockage in-app only.
// meta: uniquement IDs de routage + fromUserId/otherUserId.
//   jamais de montants, jamais de données sensibles.
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  message   String
  meta      Json?

  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// PUSH TOKENS
// ============================================================

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // 'ios' | 'android' | 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// JEU DE CARTES
// ============================================================

model CardGameSession {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        CardGameStatus  @default(ACTIVE)
  deck          Json            // [{index, suit}]×10 — jamais exposé au client
  revealed      Int             @default(0)  // bitmask 10 bits
  gainsCurrent  Int             @default(0)
  entryAmount   Int             @default(20)
  claimedAmount Int?
  expiresAt     DateTime
  claimedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([userId, status])
  @@index([status, expiresAt])
}

// ============================================================
// LE REFUGE — Jeu anonyme 7 jours (Chantier 2)
// ============================================================

enum RefugeAnimalType {
  HAMSTER
  LAPIN
  CHAT
  CHIEN
  RENARD
  PINGOUIN
  IGUANE
  PANDA
  LICORNE
  DRAGON
}

enum RefugeAnimalCategory {
  SIMPLE
  RARE
  EXOTIQUE
}

enum RefugeAnimalSexe {
  MALE
  FEMELLE
  NEUTRE
}

enum RefugeAcceptedSexe {
  HOMME
  FEMME
  HOMME_FEMME
}

enum RefugeAction {
  NOURRIR
  JOUER
  CARESSER
  LAVER
}

enum RefugeSessionStatus {
  CREATION
  WAITING_FOR_ADOPTANT
  ACTIVE
  AWAITING_REVEAL_CONSENT
  REVEALED
  COMPLETED
  ABANDONED
}

enum RefugeRevealDecision {
  ACCEPT
  REFUSE
}

// Statut FINAL d'une journée de Refuge (persisté à la clôture du jour)
enum RefugeDayStatus {
  FAILED                      // les deux ont joué, 0/2
  PARTIAL                     // les deux ont joué, 1/2
  PERFECT                     // les deux ont joué, 2/2
  INCOMPLETE_ADOPTE_MISSING   // l'Adopté n'a pas choisi (l'Adoptant était présent)
  INCOMPLETE_ADOPTANT_MISSING // choix fait, pas de réponse de l'Adoptant
  NOT_PLAYED                  // aucun des deux n'a participé
}

enum RefugePreexistingLinkType {
  MATCH
  LETTER
  SALON
  PRIVATE_MESSAGE
}

enum RefugeBackground {
  FORET
  PLAGE
  NEIGE
  AUTOMNE
  MONTAGNE
  NUIT_ETOILEE
}

model RefugeSession {
  id                        String                      @id @default(cuid())

  // Rôles
  adopteId                  String
  adopte                    User                        @relation("RefugeAdopte", fields: [adopteId], references: [id], onDelete: Cascade)
  adoptantId                String?
  adoptant                  User?                       @relation("RefugeAdoptant", fields: [adoptantId], references: [id], onDelete: SetNull)

  // Animal masque
  animalType                RefugeAnimalType
  animalCategory            RefugeAnimalCategory
  animalSexe                RefugeAnimalSexe
  animalAgeMonths           Int                         // âge en mois (généré aléatoirement)
  acceptedSexe              RefugeAcceptedSexe

  // Timeline
  createdAt                 DateTime                    @default(now())
  startedAt                 DateTime?                   // quand adoptant rejoint
  endsAt                    DateTime?                   // createdAt + 7 jours

  // État
  status                    RefugeSessionStatus         @default(CREATION)
  lastAdopteActivityAt      DateTime                    @default(now())
  lastAdoptantActivityAt    DateTime?
  inactivityAlertSentAt     DateTime?                   // 24h
  finalAlertSentAt          DateTime?                   // 48h
  preexistingLinkType       RefugePreexistingLinkType?

  // Esthétique
  background                RefugeBackground            @default(FORET)

  // Phase finale — consentement au dévoilement des profils (jour 7 terminé)
  adopteRevealDecision      RefugeRevealDecision?
  adoptantRevealDecision    RefugeRevealDecision?
  revealedAt                DateTime?

  // Relations
  dailyChoices              RefugeDailyChoice[]
  guesses                   RefugeGuess[]
  dayResults                RefugeDayResult[]

  // Index
  @@unique([adopteId, adoptantId])
  @@index([status, endsAt])
  @@index([adopteId])
  @@index([adoptantId])
  @@index([status, createdAt])
}

model RefugeDailyChoice {
  id                String          @id @default(cuid())
  refugeSessionId   String
  refugeSession     RefugeSession   @relation(fields: [refugeSessionId], references: [id], onDelete: Cascade)
  dayNumber         Int             // 1-7
  action1           RefugeAction
  action2           RefugeAction
  submittedAt       DateTime        @default(now())

  // Index
  @@unique([refugeSessionId, dayNumber])
  @@index([refugeSessionId, dayNumber])
}

model RefugeGuess {
  id                String          @id @default(cuid())
  refugeSessionId   String
  refugeSession     RefugeSession   @relation(fields: [refugeSessionId], references: [id], onDelete: Cascade)
  dayNumber         Int             // 1-7
  guessedAction1    RefugeAction
  guessedAction2    RefugeAction
  submittedAt       DateTime        @default(now())

  // Index
  @@unique([refugeSessionId, dayNumber])
  @@index([refugeSessionId, dayNumber])
}

// Résultat FINAL persisté d'une journée de Refuge.
// La contrainte unique (session, jour) garantit l'idempotence de la clôture :
// une relance du job ne peut jamais recréer le résultat ni doubler les pièces.
model RefugeDayResult {
  id                  String          @id @default(cuid())
  refugeSessionId     String
  refugeSession       RefugeSession   @relation(fields: [refugeSessionId], references: [id], onDelete: Cascade)
  dayNumber           Int             // 1-7
  status              RefugeDayStatus
  matchCount          Int?            // 0-2 si les deux ont joué, null sinon
  adopteCoinsDelta    Int             // delta théorique appliqué à l'Adopté
  adoptantCoinsDelta  Int             // delta théorique appliqué à l'Adoptant
  closedAt            DateTime        @default(now())

  @@unique([refugeSessionId, dayNumber])
  @@index([refugeSessionId])
}
