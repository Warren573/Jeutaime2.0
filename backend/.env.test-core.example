# JeuTaime TEST CORE — environnement séparé
# Copier ce fichier vers un environnement de test uniquement.

NODE_ENV=test
PORT=3100
API_PREFIX=/api

# OBLIGATOIRE: base PostgreSQL dédiée au TEST. Ne jamais mettre l'URL de production ici.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jeutaime_test_core

JWT_ACCESS_SECRET=change-me-test-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=change-me-test-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:8081
UPLOAD_DIR=./storage/test-core/photos
MAX_FILE_SIZE_MB=5

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_LETTERS_MAX=200
RATE_LIMIT_LETTERS_WINDOW_MS=3600000
RATE_LIMIT_REPORTS_MAX=50
RATE_LIMIT_REPORTS_WINDOW_MS=3600000
RATE_LIMIT_PHOTO_UPLOAD_MAX=100
RATE_LIMIT_PHOTO_UPLOAD_WINDOW_MS=3600000

LOG_LEVEL=debug
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MS=300000
REFRESH_TOKEN_PURGE_GRACE_MS=3600000
