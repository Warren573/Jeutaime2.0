{
  "expo": {
    "name": "JeuTaime TEST",
    "slug": "jeutaime-test",
    "version": "2.0.0-test",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "jeutaime-test",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeutaime.test",
      "requiresFullScreen": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F2F2F2"
      },
      "package": "com.jeutaime.test"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "index": "./public/index.html"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
