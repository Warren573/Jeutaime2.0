# Ce fichier est TRACKÉ dans git et lu par `expo export` au build (Vercel inclus).
# Il DOIT donc pointer vers l'API de production publique — jamais localhost —
# car `expo export -p web` ne charge PAS .env.production (seul .env est lu).
#
# Pour le développement local avec un backend sur localhost, crée un fichier
# `.env.local` (gitignored) : il surcharge ce fichier uniquement en local.
EXPO_PUBLIC_API_URL=https://jeutaime-staging.onrender.com/api

# Panneau DEV du Refuge : true = visible (dev/staging), false = masqué (prod).
EXPO_PUBLIC_REFUGE_DEV=false
