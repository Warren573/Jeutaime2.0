# LOCAL DEV: Utilise localhost si backend local est lancé
# PRODUCTION (Vercel): Défini via variables d'environnement Vercel
# Fallback si variable non définie: https://jeutaime-staging.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Panneau DEV du Refuge (time travel / reset / abandon).
# Ce fichier est lu par `expo export` au build : staging et dev l'ont a true.
# PRODUCTION : definir EXPO_PUBLIC_REFUGE_DEV=false dans les variables
# d'environnement du build (elles priment sur ce fichier) pour le masquer.
EXPO_PUBLIC_REFUGE_DEV=true
